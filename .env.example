PORT=5000
FRONTEND_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/roboadvisor

# Keep local mode by default. For Gemini, set ASSISTANT_PROVIDER=gemini
# and provide a Gemini API key in this backend-only .env file.
ASSISTANT_PROVIDER=local
GEMINI_MODEL=gemini-3.5-flash
GEMINI_API_KEY=
