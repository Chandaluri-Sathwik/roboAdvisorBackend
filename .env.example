PORT=5000
FRONTEND_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/roboadvisor
# Optional: enables Alpha Vantage commodity references and market-news context
# in the assistant. Sign up at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=
# Required for the server-side Gemini assistant.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional: set to true to enable Gemini's Google Search grounding.
GEMINI_GOOGLE_SEARCH_ENABLED=false
